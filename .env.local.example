# Instagram / Meta App credentials
# Create a Meta App at https://developers.facebook.com/
# Enable: Instagram Basic Display API + Instagram Graph API
# Your Instagram account must be a Business or Creator account linked to a Facebook Page

INSTAGRAM_APP_ID=your_meta_app_id_here
INSTAGRAM_APP_SECRET=your_meta_app_secret_here

# The base URL of your app (no trailing slash)
# For local development use http://localhost:3000
# Add this as a valid OAuth Redirect URI in your Meta App settings: {NEXT_PUBLIC_BASE_URL}/api/instagram/callback
NEXT_PUBLIC_BASE_URL=http://localhost:3000
